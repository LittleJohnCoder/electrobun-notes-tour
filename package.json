{
	"name": "electrobun-notes-tour",
	"version": "0.0.1",
	"type": "module",
	"description": "A 3-panel notes app on Electrobun v1 whose real product is a guided tour of typed RPC",
	"scripts": {
		"start": "electrobun dev",
		"dev": "electrobun dev --watch",
		"typecheck": "tsc --noEmit",
		"build:canary": "electrobun build --env=canary"
	},
	"dependencies": {
		"electrobun": "1.18.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/bun": "1.3.8",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/three": "^0.165",
		"typescript": "^5.7.2"
	}
}
